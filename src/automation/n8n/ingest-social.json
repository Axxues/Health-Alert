{
  "name": "ingest-social",
  "nodes": [
    {
      "id": "social-cron",
      "name": "cron-2h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "social-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "ingest-social",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "social-normalize",
      "name": "Extract Community Social Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        50
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst timeKey = new Date().toISOString().slice(0, 13);\nconst socialSignals = [\n  { disease: 'dengue', count: 6, sourceKey: 'social-dengue-' + timeKey, feed: 'social' },\n  { disease: 'leptospirosis', count: 4, sourceKey: 'social-lepto-' + timeKey, feed: 'social' },\n  { disease: 'ili', count: 5, sourceKey: 'social-ili-' + timeKey, feed: 'social' },\n  { disease: 'asthma', count: 3, sourceKey: 'social-asthma-' + timeKey, feed: 'social' }\n];\n\nreturn socialSignals.map(s => ({ json: s }));\n"
      }
    },
    {
      "id": "social-post",
      "name": "POST Ingest Social",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5109/api/surveillance/ingest/social",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "cron-2h": {
      "main": [
        [
          {
            "node": "Extract Community Social Signals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "Extract Community Social Signals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Community Social Signals": {
      "main": [
        [
          {
            "node": "POST Ingest Social",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}