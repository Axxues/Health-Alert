{
  "name": "alert-fanout",
  "nodes": [
    {
      "id": "fanout-cron",
      "name": "cron-10min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "fanout-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "alert-fanout",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "fanout-fetch",
      "name": "GET Active Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        50
      ],
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:5109/api/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "cron-10min": {
      "main": [
        [
          {
            "node": "GET Active Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "GET Active Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}