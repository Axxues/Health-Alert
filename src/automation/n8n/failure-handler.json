{
  "name": "failure-handler",
  "nodes": [
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "error-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "failure-handler",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "error-format",
      "name": "Format Incident Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        50
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst err = $input.first()?.json || {};\nreturn [{\n  json: {\n    title: 'Surveillance Ingest Warning',\n    message: err.execution?.error?.message || err.message || 'Workflow exception logged in surveillance cluster'\n  }\n}];\n"
      }
    },
    {
      "id": "error-post",
      "name": "POST Log System Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5109/api/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format Incident Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "Format Incident Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Incident Alert": {
      "main": [
        [
          {
            "node": "POST Log System Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}