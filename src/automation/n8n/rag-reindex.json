{
  "name": "rag-reindex",
  "nodes": [
    {
      "id": "rag-cron",
      "name": "cron-weekly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "rag-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "rag-reindex",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "rag-post",
      "name": "POST RAG Reindex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5109/api/rag/reindex",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}"
      }
    }
  ],
  "connections": {
    "cron-weekly": {
      "main": [
        [
          {
            "node": "POST RAG Reindex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "POST RAG Reindex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}