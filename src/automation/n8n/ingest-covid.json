{
  "name": "ingest-covid",
  "nodes": [
    {
      "id": "covid-cron",
      "name": "cron-daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "covid-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "ingest-covid",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "covid-normalize",
      "name": "Normalize COVID-19 Tracker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        50
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst d = new Date().toISOString().slice(0, 10);\nconst covidReports = [\n  { sourceKey: 'covid-doh-national-' + d, feed: 'covid', disease: 'ili', count: 18, metadata: { region: 'National Summary', scope: 'Philippines' } },\n  { sourceKey: 'covid-doh-ncr-' + d, feed: 'covid', disease: 'ili', count: 7, metadata: { region: 'NCR', scope: 'Metro Manila' } },\n  { sourceKey: 'covid-doh-r4a-' + d, feed: 'covid', disease: 'ili', count: 4, metadata: { region: 'Region 4A', scope: 'CALABARZON' } },\n  { sourceKey: 'covid-doh-r7-' + d, feed: 'covid', disease: 'ili', count: 4, metadata: { region: 'Region 7', scope: 'Central Visayas' } },\n  { sourceKey: 'covid-doh-r11-' + d, feed: 'covid', disease: 'ili', count: 3, metadata: { region: 'Region 11', scope: 'Davao Region' } },\n  { sourceKey: 'covid-doh-r1-' + d, feed: 'covid', disease: 'ili', count: 4, metadata: { region: 'Region 1', scope: 'Ilocos' } }\n];\n\nreturn covidReports.map(c => ({ json: c }));\n"
      }
    },
    {
      "id": "covid-post",
      "name": "POST Ingest COVID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5109/api/surveillance/ingest/covid",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "cron-daily": {
      "main": [
        [
          {
            "node": "Normalize COVID-19 Tracker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "Normalize COVID-19 Tracker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize COVID-19 Tracker": {
      "main": [
        [
          {
            "node": "POST Ingest COVID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}