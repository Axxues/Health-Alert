{
  "name": "ingest-heatmap",
  "nodes": [
    {
      "id": "heatmap-cron",
      "name": "cron-daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "heatmap-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "ingest-heatmap",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "heatmap-normalize",
      "name": "Extract 4-Disease Spatial Clusters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        50
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst d = new Date().toISOString().slice(0, 10);\nconst clusters = [\n  { disease: 'dengue', count: 22, sourceKey: 'heatmap-dengue-' + d, feed: 'heatmap' },\n  { disease: 'leptospirosis', count: 12, sourceKey: 'heatmap-lepto-' + d, feed: 'heatmap' },\n  { disease: 'ili', count: 18, sourceKey: 'heatmap-ili-' + d, feed: 'heatmap' },\n  { disease: 'asthma', count: 10, sourceKey: 'heatmap-asthma-' + d, feed: 'heatmap' }\n];\n\nreturn clusters.map(c => ({ json: c }));\n"
      }
    },
    {
      "id": "heatmap-post",
      "name": "POST Ingest Heatmap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5109/api/surveillance/ingest/heatmap",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "cron-daily": {
      "main": [
        [
          {
            "node": "Extract 4-Disease Spatial Clusters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "Extract 4-Disease Spatial Clusters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract 4-Disease Spatial Clusters": {
      "main": [
        [
          {
            "node": "POST Ingest Heatmap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}