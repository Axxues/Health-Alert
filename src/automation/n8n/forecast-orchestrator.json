{
  "name": "forecast-orchestrator",
  "nodes": [
    {
      "id": "forecast-cron",
      "name": "cron-daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "forecast-webhook",
      "name": "webhook-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        150
      ],
      "parameters": {
        "path": "forecast-run",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "forecast-plan",
      "name": "Plan Nationwide Forecast Matrix",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        50
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\n// Orchestrate predictive forecast across all 4 diseases for key metropolitan hubs in the Philippines\nconst runs = [\n  // NCR\n  { disease: 'dengue', muni: 'Quezon City' },\n  { disease: 'leptospirosis', muni: 'City of Manila' },\n  { disease: 'ili', muni: 'Caloocan City' },\n  { disease: 'asthma', muni: 'Pasig City' },\n\n  // Visayas\n  { disease: 'dengue', muni: 'Cebu City' },\n  { disease: 'dengue', muni: 'Iloilo City' },\n  { disease: 'leptospirosis', muni: 'Mandaue City' },\n\n  // Mindanao\n  { disease: 'dengue', muni: 'Davao City' },\n  { disease: 'ili', muni: 'Davao City' },\n  { disease: 'dengue', muni: 'Cagayan de Oro City' },\n\n  // Luzon\n  { disease: 'dengue', muni: 'City of San Fernando (Pampanga)' },\n  { disease: 'ili', muni: 'Baguio City' },\n  { disease: 'asthma', muni: 'Baguio City' },\n  { disease: 'dengue', muni: 'San Fernando City (La Union)' },\n  { disease: 'leptospirosis', muni: 'Agoo' },\n  { disease: 'ili', muni: 'Laoag City' }\n];\n\nreturn runs.map(r => ({ json: r }));\n"
      }
    },
    {
      "id": "forecast-post",
      "name": "POST Run Forecast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        550,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5109/api/forecast/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Cron-Key",
              "value": "dev-cron-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "cron-daily": {
      "main": [
        [
          {
            "node": "Plan Nationwide Forecast Matrix",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "Plan Nationwide Forecast Matrix",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plan Nationwide Forecast Matrix": {
      "main": [
        [
          {
            "node": "POST Run Forecast",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}